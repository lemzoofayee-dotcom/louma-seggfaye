{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "no-inline-style": "off",
    "void-style": "off",
    "attribute-boolean-style": "off",
    "no-implicit-button-type": "off",
    "long-title": "off",
    "no-trailing-whitespace": "off",
    "attr-quotes": "off",
    "unique-landmark": "off",
    "close-order": "error",
    "no-dup-id": "error",
    "element-required-attributes": "error",
    "wcag/h30": "off",
    "no-raw-characters": "off",
    "empty-heading": "off"
  }
}